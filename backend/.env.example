# Copy this file to backend/.env (same folder) and fill in real values.
# backend/.env is gitignored -- it will never be committed.
#
# Loaded automatically at backend startup (backend/app/db/connection.py),
# so once this is set up you never need to run
# `$env:HANS_DB_PASSWORD = "..."` by hand in a terminal again.

# Required for database persistence, login, registration, dashboard, admin page.
HANS_DB_PASSWORD=your-postgres-password-here

# Optional -- only needed if these differ from the defaults in docs/SETUP.md
# HANS_DB_HOST=localhost
# HANS_DB_PORT=5432
# HANS_DB_NAME=hans_triage
# HANS_DB_USER=postgres

# Optional -- only needed to make the Chat Agent do real Claude API calls
# instead of returning its labeled stub response.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional -- only needed for email notifications (password reset,
# admin-approval alerts to patients) to actually send. Without these,
# the app still works fully; emails are just skipped (logged, not sent).
# Get BREVO_API_KEY from https://app.brevo.com -> Settings -> SMTP & API.
# BREVO_SENDER_EMAIL must be a sender/domain you've verified in Brevo.
# BREVO_API_KEY=your-brevo-api-key-here
# BREVO_SENDER_EMAIL=no-reply@yourdomain.com
# BREVO_SENDER_NAME=HANS-Triage

# Optional -- where the frontend is served, used to build the link inside
# password reset emails. Defaults to the local Vite dev server.
# On Render, set this to your real https://your-app.onrender.com URL.
# APP_BASE_URL=http://localhost:5173
